# Copy to .env (gitignored). Read by `kimida-keeper` and `kimida-client` from the working
# directory (or a parent). Real environment variables and CLI flags override this file.

# --- Which chain -------------------------------------------------------------
# Solana has no "chain id"; a cluster is identified by its genesis hash. The program ID is compiled
# into the program (declare_id!), so each cluster needs the build that was deployed there.
RPC_URL=http://127.0.0.1:8899
# Refuse to run if the RPC is a different cluster. Get it with:  solana genesis-hash -u <cluster>
# (mainnet-beta: 5eykt4UsFv8P8NJdTREpY1vzqKqZKvdpKuc147dw2N9d, devnet: EtWTRABZaYq6iMfeYKouRu166VU2xqa1wcaWoxPkrZBG)
# KEEPER_EXPECTED_GENESIS_HASH=<hash for the cluster in RPC_URL>

# --- Keeper ------------------------------------------------------------------
KEEPER_KEYPAIR=keeper/keeper-keypair.json
KEEPER_STATE=keeper/keeper-state.json
# Seconds past the deadline (finalized Clock) before the keeper signs (REQ26).
KEEPER_SAFETY_MARGIN=300

# --- Owner CLI ---------------------------------------------------------------
OWNER_KEYPAIR=~/.config/solana/id.json
