# Copy to .env (gitignored). Vite exposes only VITE_* variables to the browser.
VITE_RPC_URL=https://api.devnet.solana.com
VITE_PROGRAM_ID=Egn9Kgqa8sLT2F5u5DS26Bg791eW51HfKKuqSSp8euke
# The keeper pubkey that becomes the nonce authority + co-signer of every plan created here.
VITE_KEEPER_PUBKEY=AsEvw9nKTdCjW3hK3RiJtwNb2rNwaf8EYZmyRABCFGBM
# Grace period (seconds) applied to every plan created from this UI. The program rejects values
# below its minimum (1s on the demo build, 1 hour on production bounds).
VITE_GRACE_SECONDS=10
# Smallest check-in period the deployed program accepts (5 on the demo build, 86400 in production).
VITE_MIN_INTERVAL_SECONDS=5
